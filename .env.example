# Supabase (required)
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Note: NEXT_PUBLIC_ vars are safe to expose in the browser.
# The anon key is NOT a secret — it is protected by Supabase Row Level Security (RLS).

# Geoapify Geocoding API (for location autocomplete)
# Get a free key at https://www.geoapify.com/ (no credit card required)
GEOAPIFY_API_KEY=your-geoapify-api-key-here
