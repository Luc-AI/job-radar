# Supabase (required)
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Note: NEXT_PUBLIC_ vars are safe to expose in the browser.
# The anon key is NOT a secret — it is protected by Supabase Row Level Security (RLS).

# Geoapify Geocoding API (for location autocomplete)
# Get a free key at https://www.geoapify.com/ (no credit card required)
GEOAPIFY_API_KEY=fa26fad2b502430b82962547e7f2d554

# Canonical site URL (required in production)
# Used by auth callback to prevent open redirect attacks — set to your deployed domain
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Sentry error monitoring (required in production)
# Create a project at https://sentry.io and paste your DSN here
NEXT_PUBLIC_SENTRY_DSN=https://your-key@oXXXXXX.ingest.sentry.io/XXXXXXX
